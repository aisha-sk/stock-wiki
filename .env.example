# Copy to .env and fill in. Never commit .env.

# api: where artifact JSON is read from, relative to the repo root.
# contracts/examples = fake demo data. data/artifacts = real pipeline output.
DATA_DIR=contracts/examples
# where alert sign-ups are stored (SQLite), relative to the repo root
ALERTS_DB=api/alerts.db
# comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# web
NEXT_PUBLIC_API_URL=http://localhost:8000

# ml (all optional: the pipeline falls back to yfinance when FINNHUB_API_KEY is empty)
FINNHUB_API_KEY=
# Reddit needs approved API access (Responsible Builder Policy). Leave this off until approved.
REDDIT_ENABLED=
REDDIT_USER_AGENT=stocksense-research/0.1
MLFLOW_TRACKING_URI=file:./mlruns

# agent (stretch)
ANTHROPIC_API_KEY=
# model used by POST /api/explain
EXPLAIN_MODEL=claude-opus-5-5
