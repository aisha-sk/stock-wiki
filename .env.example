# Copy to .env and fill in. Never commit .env.

# api: where artifact JSON is read from, relative to the repo root.
# contracts/examples = fake demo data. data/artifacts = real pipeline output.
DATA_DIR=contracts/examples
# comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# web
NEXT_PUBLIC_API_URL=http://localhost:8000

# ml (all optional: the pipeline falls back to yfinance when FINNHUB_API_KEY is empty)
FINNHUB_API_KEY=
REDDIT_USER_AGENT=sentifi-research/0.1
MLFLOW_TRACKING_URI=file:./mlruns

# agent (stretch)
ANTHROPIC_API_KEY=
# model used by POST /api/explain
EXPLAIN_MODEL=claude-sonnet-5-5
